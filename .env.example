# =============================================================================
# CreativeFlow AI — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit .env.local.
# Variables prefixed with NEXT_PUBLIC_ are sent to the browser; everything else
# stays on the server.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public base URL (origin only, no path), used in invite links, auth email
# redirects and page metadata. Local development may use http://localhost:3000.
# Production builds fail if it is missing, and deployments (Vercel production
# or preview, or REQUIRE_PUBLIC_SITE_URL=true elsewhere) also fail if it is not
# a public https:// URL. On Vercel previews it may be left unset; the preview's
# own URL is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) -----------------------------------------------------
# Dashboard → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. The secret key (sb_secret_...) or legacy service_role key.
# Used only by trusted server code: it records AI Studio results (required for
# AI Studio) and, later, verified payment webhooks. Never expose it.
SUPABASE_SECRET_KEY=

# --- File uploads (Phase 3) -------------------------------------------------
# Optional. Your project's global upload limit in bytes, from Supabase
# Dashboard → Storage → Settings ("Upload file size limit"). It depends on your
# plan (Free: 50 MB = 52428800) and cannot be read automatically. When set,
# files over the limit are rejected before uploading. Without it, the bucket
# limit is enforced and Supabase rejects larger files during upload.
STORAGE_MAX_UPLOAD_BYTES=

# --- AI Studio: scripts & storyboards (Phase 5) ------------------------------
# AI Studio also needs SUPABASE_SECRET_KEY (above). All of these are SERVER
# ONLY: never prefix them with NEXT_PUBLIC_.
#
# Which provider to use: "gemini" (default) or "anthropic". Only the selected
# provider is ever called; there is no fallback to another provider or model.
# `npm run test:ai-live` needs this set explicitly.
AI_PROVIDER=gemini

# Google Gemini API (free tier). Create a key at
# https://aistudio.google.com/app/apikey in a Google Cloud project WITHOUT
# billing enabled, so requests can only use free-tier quota and are never
# charged. See docs/SETUP.md ("AI Studio") before choosing the model.
GEMINI_API_KEY=
# Required for Gemini: a model code whose Free Tier column says "Free of
# charge" on https://ai.google.dev/gemini-api/docs/pricing (no default).
GEMINI_MODEL=

# Anthropic (paid; used only when AI_PROVIDER=anthropic).
# https://console.anthropic.com/settings/keys. Set a monthly spend limit in the
# Anthropic Console as a hard cap on top of the app's own limits.
ANTHROPIC_API_KEY=
# Optional. Anthropic model ID; defaults to claude-sonnet-5-5 (Claude Sonnet
# 5.5, $2 / $10 per million input / output tokens). Use an exact ID from
# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=

# --- Payments (Phase 6) ------------------------------------------------------
# SERVER ONLY. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# SERVER ONLY. Signing secret of the webhook endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
